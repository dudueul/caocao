  mTrueTypeFont: {fileID: 0}
  mFont: {fileID: 114724804207875695, guid: 317a6d81ebf525548a3045a2cc15cc20, type: 2}
  mText: "1일 1회, 30분 ~ 3시간 까지 점령 가능합니다. \r\n중립 거점 유실 시 당일 재 점령 불가능합니다.\r\n점령 시간에 따라 보상을 획득합니다.\r\n점령 성공 시 생산량의 100%를 받습니다.\r\n점령 실패 시 생산량의 50%만 받습니다.\r\n점령 보상은 서신으로 지급됩니다."
  mFontSize: 22
  mFontStyle: 0
  mAlignment: 1
  mEncoding: 1
  mMaxLineCount: 0
  mEffectStyle: 3
  mEffectColor: {r: 0.13725491, g: 0.03137255, b: 0.019607844, a: 1}
