  mFont: {fileID: 114724804207875695, guid: 317a6d81ebf525548a3045a2cc15cc20, type: 2}
  mText: "토벌 보상은 사신을 토벌 했을때 지급되는 보상입니다.\n기록 보상은 사신전에서 기록한 수치에 따라 퍼센트로 지급되는 보상입니다.\n[ffe400]참고 :[-] 기록 보상 위패 10 : 사신의 최대 HP 기준 10%를 기록할 경우 위패 1개 획득"
  mFontSize: 30
  mFontStyle: 0
  mAlignment: 2
  mEncoding: 1
  mMaxLineCount: 0
  mEffectStyle: 2
  mEffectColor: {r: 0, g: 0, b: 0, a: 1}
