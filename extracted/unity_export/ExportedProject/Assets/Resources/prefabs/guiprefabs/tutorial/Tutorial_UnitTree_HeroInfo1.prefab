  mTrueTypeFont: {fileID: 0}
  mFont: {fileID: 114724804207875695, guid: 317a6d81ebf525548a3045a2cc15cc20, type: 2}
  mText: "-장수의 강화등급에 따라 착용할 수 있는 장비가 제한됩니다\n-장수를 다음 단계로 강화하려면 다음 단계의 장비를 모두 착용해야 합니다\n-일반 장비는 해제가 불가능하며, 오직 상위 단계로 교체만 가능합니다\n-장비를 교체하고 싶다면 [ffe400]강화\r\r[ffffff] 탭에서 가능합니다"
  mFontSize: 30
  mFontStyle: 0
  mAlignment: 1
  mEncoding: 1
  mMaxLineCount: 0
  mEffectStyle: 2
  mEffectColor: {r: 0, g: 0, b: 0, a: 1}
