{
  "name": "tk",
  "private": true,
  "type": "module",
  "description": "Three Kingdoms grid-tactics remake (working name)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run determinism && bun test",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/server/tsconfig.json && bun run --cwd apps/client check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "determinism": "bun scripts/check-determinism.mjs",
    "dev": "bun run --cwd apps/client dev",
    "build": "bun run --cwd apps/client build",
    "server": "bun run --cwd apps/server dev"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
